# ==================================================
# DEMO-MARISCAL - Variables de entorno de ejemplo
# ==================================================
# Copia este archivo como ".env" (en la misma carpeta) para ejecutar la
# demostracion en local con Docker Compose. El archivo ".env" real esta
# ignorado por git (ver .gitignore) y NUNCA debe subirse al repositorio.

# ---- PostgreSQL ----
DB_NAME=biopet_db
DB_USER=biopet_user
DB_PASSWORD=biopet_pass
DB_URL=jdbc:postgresql://postgres:5432/biopet_db

# ---- JWT ----
# Clave de ejemplo SOLO para uso local/academico. No usar en produccion.
JWT_SECRET=9c8f9a7d6e5b4c3a2d1f0e9c8b7a6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- CORS (cliente Astro de la demo) ----
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
