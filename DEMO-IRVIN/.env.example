# ==================================================
# DEMO-SGB - Variables de entorno de ejemplo
# ==================================================
# Copia este archivo como ".env" (en la misma carpeta) para ejecutar la
# demostracion en local con Docker Compose. El archivo ".env" real esta
# ignorado por git (ver .gitignore) y NUNCA debe subirse al repositorio.

# ---- PostgreSQL ----
DB_NAME=sgb_db
DB_USER=sgb_user
DB_PASSWORD=changeme

# ---- JWT ----
# Clave de ejemplo SOLO para uso local/academico. No usar en produccion.
# Generar una real con: openssl rand -hex 32
JWT_SECRET=dev_secret_cambiar_en_produccion_min_32_chars

# ---- Redis / cache ----
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_LIBROS_TTL_SECONDS=300

# ---- CORS ----
# Configurado directamente en SecurityConfig.java (no via variable de
# entorno): permite http://localhost:4200 (Angular) y http://localhost:4321
# (cliente Astro de esta demo).
